# Copy to .env and adjust as needed.
# The service reads these via pydantic-settings (see src/caseware_sync/core/config.py).

# Postgres connection used by the service
DATABASE_URL=postgresql://interop:interop@localhost:5432/interop

# HTTP server bind
APP_HOST=0.0.0.0
APP_PORT=8000

# Local output roots (relative paths are resolved from the working directory).
# These match the spec exactly: ./state, ./lake, ./share, ./events.
STATE_DIR=./state
LAKE_DIR=./lake
SHARE_DIR=./share
EVENTS_DIR=./events

# Hash prefix used as the run_id (full SHA-256 hex is 64 chars; 32 is plenty for
# uniqueness in this exercise and keeps file names readable).
RUN_ID_HEX_PREFIX_LEN=32
